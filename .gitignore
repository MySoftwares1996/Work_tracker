node_modules/
.expo/
dist/

# Generated by `expo prebuild`. The leading slash matters: without it these
# patterns match at ANY depth, and "android/" silently excluded
# modules/native-tools/android/ - the hand-written native module - so EAS
# builds never received it.
/android/
/ios/

*.apk
*.aab
npm-debug.*
.DS_Store

.native-cache/

# Signing keys and downloaded EAS credentials must never be committed.
*.jks
*.keystore
!debug.keystore
credentials.json
credentials/
*.b64

# Written by scripts/deploy-web.js for one deploy, then removed.
firebase.web-deploy.json
.firebase/
.env
.env.local
