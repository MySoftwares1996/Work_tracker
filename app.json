{
  "expo": {
    "name": "Working Dashboard",
    "slug": "work-tracker",
    "owner": "mysoftwares1996s-team",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "workingdashboard",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.koteswara.workingdashboard",
      "intentFilters": [
        { "action": "SEND", "category": ["DEFAULT"], "data": [{ "mimeType": "text/plain" }] }
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#14B8A6"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_HEALTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Working Dashboard",
      "shortName": "Work Dash",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0B1220",
      "backgroundColor": "#0B1220"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#14B8A6",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ping.wav",
            "./assets/sounds/drop.wav",
            "./assets/sounds/alarm.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ],
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "./plugins/withAsyncStorageSize",
        {
          "sizeInMB": 50
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withSeparateNotifications",
      "./plugins/withAlarmMainActivity",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WorkSummaryWidget",
              "label": "Work summary",
              "description": "overdue, due today and open entries",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WorkTodayWidget",
              "label": "Work today",
              "description": "Overdue and today's entries; tick them off from the home screen",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WorkNextWidget",
              "label": "Next up",
              "description": "The next entry due and the nearest deadline",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "backgroundColor": "#0B1220"
  }
}
