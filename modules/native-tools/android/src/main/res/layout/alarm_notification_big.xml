<?xml version="1.0" encoding="utf-8"?>
<!--
  The ringing alarm's notification, expanded and as a heads-up: title, body and up to four buttons -
  Snooze 15m, Done, DAR, Reminder only - shown as symbols (💤 15m, ✓, ✓ DAR, 🔔 - as on the cards) on one line (the full name is read out by a
  screen reader). Android's own action row stops at three, hence this layout.
  AlarmRingService hides the buttons a given alarm does not have.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <TextView
    android:id="@+id/alarm_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="2"
    android:ellipsize="end"
    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
  <TextView
    android:id="@+id/alarm_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="5"
    android:ellipsize="end"
    android:textAppearance="@android:style/TextAppearance.Material.Notification" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/alarm_btn_snooze"
      style="@style/AlarmNotificationButton"
      android:contentDescription="Snooze 15 minutes"
      android:text="💤 15m" />
    <TextView
      android:id="@+id/alarm_btn_done"
      style="@style/AlarmNotificationButton"
      android:contentDescription="Done"
      android:text="✓" />
    <TextView
      android:id="@+id/alarm_btn_dar"
      style="@style/AlarmNotificationButton"
      android:contentDescription="Done, in the Daily Activity Report"
      android:text="✓ DAR" />
    <TextView
      android:id="@+id/alarm_btn_remind"
      style="@style/AlarmNotificationButton"
      android:contentDescription="Reminder only"
      android:text="🔔" />
  </LinearLayout>
</LinearLayout>
